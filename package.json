{
  "name": "vagdevifoods-app",
  "homepage": "https://vagdevifoods.com",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run manifest && npm run build:client && npm run build:ssr && npm run prerender && npm run sitemap && npm run llms",
    "manifest": "node scripts/generate-image-manifest.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "llms": "node scripts/generate-llms.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:styles": "node scripts/check-styles.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "images": "node scripts/optimize-images.mjs",
    "check": "npm run typecheck && npm run lint:styles && npm run build && npm run check:seo",
    "predeploy": "npm run check",
    "deploy": "npx --yes gh-pages@6 -d dist"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
